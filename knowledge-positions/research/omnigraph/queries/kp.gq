// Caller supplies the deterministic lexical vector; no provider.
query search($vq: Vector(512), $tq: String) @description("Discovery without an embedding provider: lexical-hash-512 proximity fused with full-text relevance.") {
    match {
        $k: KnowledgeItem
        $k.status = "current"
    }
    return { $k.id, $k.heading, $k.kind, $k.domain, $k.source_repo, $k.source_path, $k.start_line, $k.end_line, rrf(nearest($k.vector_lexical_hash_512, $vq), bm25($k.terms, $tq)) as score }
    order { rrf(nearest($k.vector_lexical_hash_512, $vq), bm25($k.terms, $tq)) }
    limit 10
}

// One item with its full location, for evidence resolution.
query item($id: String) @description("One knowledge item with its source location and position.") {
    match { $k: KnowledgeItem { id: $id } }
    return { $k.id, $k.kind, $k.domain, $k.heading, $k.status, $k.status_history, $k.owner_namespace, $k.source_id, $k.source_address, $k.source_repo, $k.source_commit, $k.source_path, $k.source_version_sha256, $k.source_precision, $k.position_unit, $k.start_byte, $k.end_byte, $k.start_line, $k.end_line, $k.span_sha256, $k.within_path, $k.location_method, $k.location_basis, $k.location_precision, $k.location_coordinates, $k.vector_lexical_hash_512_status }
}

// Maintenance inventory: everything needed to compare a rescan without reading vectors.
query inventory() @description("All knowledge items with identity, location and lifecycle, for incremental maintenance.") {
    match { $k: KnowledgeItem }
    return { $k.id, $k.source_id, $k.source_repo, $k.source_path, $k.span_sha256, $k.start_byte, $k.end_byte, $k.start_line, $k.end_line, $k.source_version_sha256, $k.status, $k.owner_namespace, $k.source_commit, $k.source_address, $k.source_precision, $k.realm, $k.possible_routes, $k.location_coordinates, $k.location_method, $k.heading }
}

// Full rows for items whose lifecycle maintenance must rewrite.
query item_rows($ids: [String]) @description("Full rows of the given items, for lifecycle updates.") {
    match {
        $k: KnowledgeItem
        $k.id in $ids
    }
    return { $k.id, $k.kind, $k.entity_type, $k.domain, $k.heading, $k.terms, $k.owner_namespace, $k.source_id, $k.source_address, $k.source_repo, $k.source_commit, $k.source_path, $k.source_version_sha256, $k.observed_source_version, $k.source_precision, $k.position_unit, $k.start_byte, $k.end_byte, $k.start_line, $k.end_line, $k.position_coordinates, $k.span_sha256, $k.ownership, $k.realm, $k.possible_routes, $k.within_path, $k.sibling_index, $k.location_coordinates, $k.location_method, $k.location_basis, $k.location_precision, $k.vector_lexical_hash_512_status, $k.vector_lexical_hash_512, $k.status, $k.status_history, $k.enrichment, $k.enrichment_touches, $k.enrichment_touch_limit, $k.enrichment_frozen }
}

// Outgoing and incoming relationships: one row per relationship, parallel evidence kept.
// Aliases keep edge and item columns apart once the MCP strips the `$x.` prefixes.
query out_rels($id: String) @description("Relationships leaving an item, with label and qualification.") {
    match {
        $a: KnowledgeItem { id: $id }
        $a $e:relationship $b
    }
    return { $e.relation, $e.qualification, $e.status as relation_status, $e.origin, $e.evidence, $b.id as item_id, $b.heading as item_heading, $b.status as item_status }
}

query in_rels($id: String) @description("Relationships arriving at an item, with label and qualification.") {
    match {
        $b: KnowledgeItem { id: $id }
        $a $e:relationship $b
    }
    return { $e.relation, $e.qualification, $e.status as relation_status, $e.origin, $e.evidence, $a.id as item_id, $a.heading as item_heading, $a.status as item_status }
}

// Bounded neighbourhood (either direction, up to three hops) and the relationships inside it.
query neighbourhood($id: String) @description("Items within three relationship hops of an item, either direction.") {
    match {
        $a: KnowledgeItem { id: $id }
        $a <relationship>{1,3} $b
    }
    return { $b.id }
    limit 50
}

query edges_among($ids: [String]) @description("Relationships whose two endpoints are both in the given set.") {
    match {
        $a: KnowledgeItem
        $a.id in $ids
        $a $e:relationship $b
        $b.id in $ids
    }
    return { $a.id as src, $b.id as dst, $e.relation, $e.qualification, $e.status as relation_status, $e.evidence_key }
}

query node_summaries($ids: [String]) @description("Heading, kind, location and status for the given items.") {
    match {
        $k: KnowledgeItem
        $k.id in $ids
    }
    return { $k.id, $k.heading, $k.kind, $k.domain, $k.source_repo, $k.source_path, $k.start_line, $k.end_line, $k.status }
}

// Explicit dependents for staleness cascades (dependent -> prerequisite labels).
query dependents($id: String) @description("Items that depend on the given item through requires, depends_on or derived_from.") {
    match {
        $p: KnowledgeItem { id: $id }
        $d $e:relationship $p
        $e.relation in ["requires", "depends_on", "derived_from"]
    }
    return { $d.id, $e.relation }
}

// Every stored relationship as (src, dst, relation), for structural-edge reconciliation.
query relationship_index() @description("All relationships as source, target and label, for maintenance reconciliation.") {
    match {
        $a: KnowledgeItem
        $a $e:relationship $b
    }
    return { $a.id as src, $b.id as dst, $e.relation }
}

query by_source($source: String) @description("Locate items by known source identity.") {
    match { $k: KnowledgeItem { source_id: $source } }
    return { $k.id, $k.heading, $k.domain, $k.start_line, $k.end_line, $k.status }
}

query enrich_item($id: String, $payload: String, $touches: I32, $frozen: Bool) {
    update KnowledgeItem set { enrichment: $payload, enrichment_touches: $touches, enrichment_frozen: $frozen } where id = $id
}
